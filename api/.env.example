# Copy this to .env and fill in real values. Never commit the real .env file.

DB_HOST=mysql
DB_USER=app_user
DB_PASSWORD=replace_with_a_strong_generated_password
DB_NAME=crud_app

# Optional TLS to MySQL. If DB_SSL=true, DB_SSL_CA_PATH must point to a real CA cert.
DB_SSL=false
DB_SSL_CA_PATH=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:3000

# Admin seeding — leave all three unset to skip seeding entirely.
# If you set these, use a strong, unique password (12+ chars).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=admin
