      "parameters": {
        "jsCode": "// ============================================================\n// CLEAN + MERGE ALL THREAT INTELLIGENCE\n// OUTPUT: EXACTLY ONE JSON ITEM\n// ============================================================\n\n\n// ============================================================\n// 1. ORIGINAL HASH CLEANING\n// ============================================================\n\nconst seenHashes = new Set();\nconst cleanedHashes = [];\n\nfor (const item of items) {\n  const data = item.json?.data;\n  if (!data || !data.attributes) continue;\n\n  const attrs = data.attributes;\n  const sha256 = attrs.sha256;\n\n  // Deduplicate by SHA256\n  if (seenHashes.has(sha256)) continue;\n  seenHashes.add(sha256);\n\n  cleanedHashes.push({\n    sha256: sha256,\n    md5: attrs.md5,\n    sha1: attrs.sha1,\n\n    file_type: attrs.type_description,\n    extension: attrs.type_extension,\n    size_bytes: attrs.size,\n    magic: attrs.magic,\n\n    reputation: attrs.reputation,\n    times_submitted: attrs.times_submitted,\n    first_seen: attrs.first_seen_itw_date,\n    last_analysis_date: attrs.last_analysis_date,\n\n    detection_stats: {\n      malicious: attrs.last_analysis_stats?.malicious,\n      suspicious: attrs.last_analysis_stats?.suspicious,\n      undetected: attrs.last_analysis_stats?.undetected\n    },\n\n    tags: attrs.tags || [],\n    packers: attrs.packers || {},\n    meaningful_name: attrs.meaningful_name,\n    known_names: attrs.names?.slice(0, 5)\n  });\n}\n\n\n// ============================================================\n// 2. IP VIRUSTOTAL\n// ============================================================\n\nlet ipVirusTotal = null;\n\nfor (const item of items) {\n\n  const json = item.json || {};\n  const data = json.data;\n\n  if (\n    data &&\n    data.type === \"ip_address\" &&\n    data.attributes\n  ) {\n\n    const attrs = data.attributes;\n    const stats = attrs.last_analysis_stats || {};\n    const analysis = attrs.last_analysis_results || {};\n\n    const maliciousEngines = [];\n    const suspiciousEngines = [];\n\n    for (const [engine, result] of Object.entries(analysis)) {\n\n      if (!result) continue;\n\n      if (result.category === \"malicious\") {\n        maliciousEngines.push({\n          engine: engine,\n          result: result.result || null\n        });\n      }\n\n      if (result.category === \"suspicious\") {\n        suspiciousEngines.push({\n          engine: engine,\n          result: result.result || null\n        });\n      }\n    }\n\n    ipVirusTotal = {\n      ip: data.id,\n\n      reputation: attrs.reputation ?? null,\n\n      country: attrs.country ?? null,\n      continent: attrs.continent ?? null,\n\n      asn: attrs.asn ?? null,\n      as_owner: attrs.as_owner ?? null,\n\n      detection_stats: {\n        malicious: stats.malicious ?? 0,\n        suspicious: stats.suspicious ?? 0,\n        undetected: stats.undetected ?? 0,\n        harmless: stats.harmless ?? 0\n      },\n\n      malicious_engines: maliciousEngines,\n      suspicious_engines: suspiciousEngines\n    };\n\n    break;\n  }\n}\n\n\n// ============================================================\n// 3. IP-API\n// ============================================================\n\nlet ipApi = null;\n\nfor (const item of items) {\n\n  const json = item.json || {};\n\n  if (\n    json.status &&\n    (\n      json.query ||\n      json.country ||\n      json.countryCode ||\n      json.isp ||\n      json.org\n    )\n  ) {\n\n    ipApi = {\n      ip: json.query ?? null,\n\n      country: json.country ?? null,\n      country_code: json.countryCode ?? null,\n\n      region: json.regionName ?? null,\n      city: json.city ?? null,\n\n      timezone: json.timezone ?? null,\n\n      isp: json.isp ?? null,\n      organization: json.org ?? null,\n      asn: json.as ?? null,\n\n      status: json.status ?? null\n    };\n\n    break;\n  }\n}\n\n\n// ============================================================\n// 4. FINAL RESULT\n// ============================================================\n// IMPORTANT:\n// Always return ONE item only.\n// Hash + IP information are inside the same JSON reference.\n// ============================================================\n\nreturn [\n  {\n    json: {\n      \n      hash_threat_intelligence: cleanedHashes,\n\n      ip_threat_intelligence: {\n        virustotal: ipVirusTotal,\n        ip_api: ipApi\n      }\n\n    }\n  }\n];"
      },
