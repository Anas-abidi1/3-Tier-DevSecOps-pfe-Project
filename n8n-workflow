        "jsCode": "try {\n    let rawLog = $input.first()?.json?.data ?? '';\n    if (typeof rawLog !== 'string') rawLog = JSON.stringify(rawLog);\n\n    // 1) Strip ANSI + normalize mojibake box-drawing chars -> │\n    const normalized = rawLog\n        .replace(/\\x1B\\[[0-9;]*[a-zA-Z]/g, '')\n        .replace(/\\u00E2\\u201D./g, '\\u2502')   // any \"â”x\" -> │\n        .replace(/\\r/g, '');\n\n    const lines = normalized.split('\\n');\n\n    const isBorder = (l) => /^\\s*[├┌└┼┬┴─]/.test(l);\n    const isRow    = (l) => l.includes('\\u2502') && !isBorder(l);\n    const hasCve   = (l) => /\\b(CVE-\\d{4}-\\d+|GHSA-[a-z0-9-]+)\\b/i.test(l);\n    const hasLib   = (l) => {\n        const c = l.split('\\u2502');\n        return c.length >= 8 && (c[1] || '').trim().length > 0;\n    };\n\n    // 2) Merge wrapped rows: continuation lines have │ but no lib and no CVE\n    const merged = [];\n    for (const line of lines) {\n        if (\n            isRow(line) && !hasCve(line) && !hasLib(line) &&\n            merged.length && isRow(merged[merged.length - 1])\n        ) {\n            merged[merged.length - 1] +=\n                ' ' + line.replace(/^\\s*\\u2502/, '').trim();\n        } else {\n            merged.push(line);\n        }\n    }\n\n    // 3) Section headers:  \"<target> (npm|node-pkg|alpine ...)\"\n    const sectionRe = /^(.+?)\\s+\\((npm|node-pkg|alpine[^)]*)\\)\\s*$/i;\n\n    const findings = [];\n    let currentSection = 'unknown';\n\n    for (const line of merged) {\n        const sec = line.match(sectionRe);\n        if (sec && !isRow(line)) {\n            currentSection = `${sec[1].trim()} (${sec[2].trim()})`;\n            continue;\n        }\n        if (!isRow(line)) continue;\n\n        const cells = line.split('\\u2502').map(c => c.trim());\n        if (cells.length < 8) continue;\n\n        // CVE / GHSA usually in cells[2], but search cells[1..3] to be safe\n        let id = null;\n        for (let i = 1; i <= 3 && i < cells.length; i++) {\n            const m = cells[i].match(/\\b(CVE-\\d{4}-\\d+|GHSA-[a-z0-9-]+)\\b/i);\n            if (m) { id = m[1]; break; }\n        }\n        if (!id) continue;\n\n        const severity = (cells[3] || '').toUpperCase();\n        if (!/CRITICAL|HIGH/.test(severity)) continue;\n\n        findings.push({\n            cve: id,\n            library: cells[1] || '',\n            severity,\n            status: cells[4] || '',\n            installedVersion: cells[5] || '',\n            fixedVersion: cells[6] || '',\n            title: cells.slice(7).filter(Boolean).join(' ').trim(),\n            section: currentSection\n        });\n    }\n\n    // 4) Deduplicate: same CVE in same section + same library\n    const seen = new Set();\n    const unique = [];\n    for (const f of findings) {\n        const key = `${f.cve}|${f.section}|${f.library}`;\n        if (!seen.has(key)) { seen.add(key); unique.push(f); }\n    }\n\n    const criticalCves = unique.filter(f => f.severity === 'CRITICAL');\n    const highCves     = unique.filter(f => f.severity === 'HIGH');\n\n    return [{\n        json: {\n            criticalCount: criticalCves.length,\n            highCount:     highCves.length,\n            totalCount:    unique.length,\n            criticalCves,\n            highCves,\n            allFindings:   unique\n        }\n    }];\n\n} catch (error) {\n    return [{\n        json: {\n            criticalCount: 0,\n            highCount: 0,\n            totalCount: 0,\n            criticalCves: [],\n            highCves: [],\n            allFindings: [],\n            error: error.message\n        }\n    }];\n}"
