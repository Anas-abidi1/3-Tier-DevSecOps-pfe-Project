        "jsCode": "const alert = $json.body || $json;\n\nconst rule = alert.rule || {};\nconst data = alert.data || {};\nconst win = data.win?.eventdata || {};\n\nconst isSysmon =\n  !!(\n    win.image ||\n    win.hashes ||\n    win.processGuid ||\n    data.win?.system?.providerName === \"Microsoft-Windows-Sysmon\"\n  );\n\nconst isWazuhNative = !isSysmon && !!alert.rule;\n\n\n// ================================\n// Rule / MITRE information\n// ================================\n\nconst mitre = rule.mitre || {};\n\nconst ruleLevel = rule.level ?? \"N/A\";\nconst ruleDescription = rule.description || \"N/A\";\nconst ruleId = rule.id || \"N/A\";\nconst ruleGroups = rule.groups || [];\nconst firedTimes = rule.firedtimes ?? \"N/A\";\n\nconst techniqueId = Array.isArray(mitre.id)\n  ? mitre.id.join(\", \")\n  : (mitre.id || \"N/A\");\n\nconst techniqueName = Array.isArray(mitre.technique)\n  ? mitre.technique.join(\", \")\n  : (mitre.technique || \"N/A\");\n\nconst tactic = Array.isArray(mitre.tactic)\n  ? mitre.tactic.join(\", \")\n  : (mitre.tactic || \"N/A\");\n\n\n// ================================\n// Agent / manager information\n// ================================\n\nconst agent = alert.agent || {};\nconst manager = alert.manager || {};\n\n\n// ================================\n// Source IP extraction\n// ================================\n\nlet sourceIp = null;\n\n\n// 1. Native Wazuh source IP\nif (data.srcip) {\n  sourceIp = data.srcip;\n}\n\n\n// 2. Windows / Sysmon source IP\nif (!sourceIp && win.sourceIp) {\n  sourceIp = win.sourceIp;\n}\n\nif (!sourceIp && win.srcIp) {\n  sourceIp = win.srcIp;\n}\n\n\n// 3. Fallback: extract source IP from full_log\nif (!sourceIp && alert.full_log) {\n\n  const sourcePatterns = [\n\n    // SSH:\n    // Failed password for invalid user fakeuser from 192.168.133.132\n    /from\\s+(\\d{1,3}(?:\\.\\d{1,3}){3})/i,\n\n    // srcip=192.168.133.132\n    /srcip[=:\\s]+(\\d{1,3}(?:\\.\\d{1,3}){3})/i,\n\n    // src=192.168.133.132\n    /src[=:\\s]+(\\d{1,3}(?:\\.\\d{1,3}){3})/i,\n\n    // sourceip=192.168.133.132\n    /sourceip[=:\\s]+(\\d{1,3}(?:\\.\\d{1,3}){3})/i,\n\n    // source=192.168.133.132\n    /source[=:\\s]+(\\d{1,3}(?:\\.\\d{1,3}){3})/i\n  ];\n\n  for (const pattern of sourcePatterns) {\n\n    const match = alert.full_log.match(pattern);\n\n    if (match) {\n      sourceIp = match[1];\n      break;\n    }\n  }\n}\n\n\n// ================================\n// File / process / hash info\n// ================================\n\nlet filePath = \"N/A\";\nlet fileName = \"N/A\";\n\nlet md5 = null;\nlet sha1 = null;\nlet sha256 = null;\n\nlet processId = \"N/A\";\nlet processGuid = \"N/A\";\nlet imageLoaded = \"N/A\";\n\nlet signed = null;\nlet signature = \"N/A\";\nlet signatureStatus = \"N/A\";\n\nlet user = alert.user || \"N/A\";\n\n\nif (isSysmon) {\n\n  filePath =\n    win.targetFilename ||\n    win.image ||\n    \"N/A\";\n\n  fileName =\n    win.image\n      ? win.image.split(/[\\\\/]/).pop()\n      : \"N/A\";\n\n  md5 =\n    win.hashes?.match(/MD5=([^,]+)/)?.[1] ||\n    null;\n\n  sha1 =\n    win.hashes?.match(/SHA1=([^,]+)/)?.[1] ||\n    null;\n\n  sha256 =\n    win.hashes?.match(/SHA256=([^,]+)/)?.[1] ||\n    null;\n\n  processId =\n    win.processId ||\n    \"N/A\";\n\n  processGuid =\n    win.processGuid ||\n    \"N/A\";\n\n  imageLoaded =\n    win.imageLoaded ||\n    win.image ||\n    \"N/A\";\n\n  signed =\n    win.signed ??\n    null;\n\n  signature =\n    win.signature ||\n    \"N/A\";\n\n  signatureStatus =\n    win.signatureStatus ||\n    \"N/A\";\n\n  user =\n    win.user ||\n    user;\n}\n\n\n// ================================\n// Log source metadata\n// ================================\n\nconst decoderName =\n  alert.decoder?.name ||\n  \"N/A\";\n\nconst programName =\n  alert.predecoder?.program_name ||\n  \"N/A\";\n\nconst location =\n  alert.location ||\n  \"N/A\";\n\n\n// ================================\n// Classify alert type\n// ================================\n\nlet alertType = \"Other\";\n\n\nif (sha256 || sha1 || md5) {\n\n  alertType = \"File\";\n\n}\n\nelse if (\n  ruleGroups.includes(\"nmap\") ||\n  ruleGroups.includes(\"reconnaissance\") ||\n  techniqueId.includes(\"T1046\")\n) {\n\n  alertType = \"Network Scan\";\n\n}\n\nelse if (isSysmon) {\n\n  alertType = \"Process\";\n\n}\n\nelse if (ruleGroups.length) {\n\n  alertType = ruleGroups[0];\n\n}\n\n\n// ================================\n// Return normalized alert\n// ================================\n\nreturn {\n\n  // General classification\n  source_format:\n    isSysmon\n      ? \"sysmon\"\n      : isWazuhNative\n        ? \"wazuh_native\"\n        : \"unknown\",\n\n  alert_type: alertType,\n\n\n  // Rule / MITRE\n  rule_level: ruleLevel,\n  rule_description: ruleDescription,\n  rule_id: ruleId,\n  rule_groups: ruleGroups,\n  fired_times: firedTimes,\n\n  tactic: tactic,\n  technique_id: techniqueId,\n  technique_name: techniqueName,\n\n\n  // Agent / manager\n  agent_name:\n    agent.name ||\n    \"Unknown\",\n\n  agent_id:\n    agent.id ||\n    \"N/A\",\n\n  agent_ip:\n    agent.ip ||\n    \"0.0.0.0\",\n\n  manager_name:\n    manager.name ||\n    \"N/A\",\n\n\n  // Source IP\n  source_ip:\n    sourceIp,\n\n\n  // File / process / hash\n  file_path:\n    filePath,\n\n  file_name:\n    fileName,\n\n  md5,\n  sha1,\n  sha256,\n\n  process_id:\n    processId,\n\n  process_guid:\n    processGuid,\n\n  image_loaded:\n    imageLoaded,\n\n  signed,\n  signature,\n\n  signature_status:\n    signatureStatus,\n\n  user,\n\n\n  // Log source\n  decoder_name:\n    decoderName,\n\n  program_name:\n    programName,\n\n  location,\n\n\n  // Original alert\n  full_log:\n    alert.full_log ||\n    \"N/A\",\n\n  timestamp:\n    alert.predecoder?.timestamp ||\n    alert.timestamp ||\n    new Date().toISOString()\n};"
