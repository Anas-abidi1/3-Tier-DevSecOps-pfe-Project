pipeline {
    agent any

    tools {
        nodejs 'nodejs23'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Git Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-token',
                    url: 'https://github.com/Anas-abidi1/3-Tier-DevSecOps-pfe-Project.git'
            }
        }
        stage('GitLeaks Scan') {
    steps {
        sh 'gitleaks dir . --exit-code 1'
    }
}

        stage('Prepare Environment') {
            steps {
                withCredentials([
                    string(credentialsId: 'mysql-root-password', variable: 'MYSQL_ROOT_PASSWORD'),
                    string(credentialsId: 'mysql-password', variable: 'MYSQL_PASSWORD'),
                    string(credentialsId: 'jwt-secret', variable: 'JWT_SECRET'),
                    string(credentialsId: 'admin-name', variable: 'ADMIN_NAME'),
                    string(credentialsId: 'admin-email', variable: 'ADMIN_EMAIL'),
                    string(credentialsId: 'admin-password', variable: 'ADMIN_PASSWORD'),
                    string(credentialsId: 'admin-role', variable: 'ADMIN_ROLE')
                ]) {
                    sh '''
                        cat > .env <<EOF
MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=crud_app
MYSQL_USER=crud_app_user
MYSQL_PASSWORD=$MYSQL_PASSWORD
JWT_SECRET=$JWT_SECRET
CLIENT_URL=http://localhost:3000
REACT_APP_API=http://localhost:5000
ADMIN_NAME=$ADMIN_NAME
ADMIN_EMAIL=$ADMIN_EMAIL
ADMIN_PASSWORD=$ADMIN_PASSWORD
ADMIN_ROLE=$ADMIN_ROLE
EOF

                        chmod 600 .env

                        echo ".env created successfully"
                    '''
                }
            }
        }

        stage('Frontend Compilation') {
            steps {
                dir('client') {
                    sh '''
                        find . -name "*.js" -exec node --check {} +
                    '''
                }
            }
        }

        stage('Backend Compilation') {
            steps {
                dir('api') {
                    sh '''
                        find . -name "*.js" -exec node --check {} +
                    '''
                }
            }
        }

        stage('Dependency Check') {
            steps {
                dependencyCheck(
                    additionalArguments: '--format HTML',
                    odcInstallation: 'dp_check',
                    skipOnScmChange: true
                )
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=Anas-PFE-Project \
                            -Dsonar.projectKey=NodeJS-Project \
                            -Dsonar.sources=api,client,mysql-init \
                            -Dsonar.exclusions=**/dependency-check-report.html,**/dependency-check-report.xml,**/fs-report.html,**/node_modules/**,**/build/**,**/dist/**,**/coverage/**
                    '''
                }
            }
        }

        stage('Quality Gate Check') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate(
                        abortPipeline: false,
                        credentialsId: 'sonar-token'
                    )
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    trivy fs \
                        --format table \
                        --severity HIGH,CRITICAL \
                        .
                '''
            }
        }

        stage('Build & Scan Backend Image') {
            steps {
                dir('api') {
                    sh '''
                        docker build \
                            -t anas999/backend:latest \
                            .

                        trivy image \
                            --format table \
                            --severity HIGH,CRITICAL \
                            anas999/backend:latest
                    '''
                }
            }
        }

        stage('Push Backend Image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred') {
                        sh '''
                            docker push anas999/backend:latest
                        '''
                    }
                }
            }
        }

        stage('Build & Scan Frontend Image') {
            steps {
                dir('client') {
                    sh '''
                        docker build \
                            -t anas999/frontend:latest \
                            .

                        trivy image \
                            --format table \
                            --severity HIGH,CRITICAL \
                            anas999/frontend:latest
                    '''
                }
            }
        }

        stage('Push Frontend Image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred') {
                        sh '''
                            docker push anas999/frontend:latest
                        '''
                    }
                }
            }
        }

        stage('Docker Compose Deploy') {
            steps {
                sh '''
                    echo "Stopping old deployment..."

                    docker compose \
                        -f docker-compose.yaml \
                        down --remove-orphans

                    docker rm -f \
                        backend-api \
                        frontend-react \
                        mysql \
                        2>/dev/null || true

                    echo "Pulling images from Docker Hub..."

                    docker pull anas999/backend:latest
                    docker pull anas999/frontend:latest

                    echo "Starting deployment..."

                    docker compose \
                        -f docker-compose.yaml \
                        up -d

                    echo "Deployment status..."

                    docker compose \
                        -f docker-compose.yaml \
                        ps
                '''
            }
        }

        stage('Application Health Check') {
            steps {
                sh '''
                    echo "Waiting for containers..."
                    sleep 10

                    echo "Container status:"
                    docker compose \
                        -f docker-compose.yaml \
                        ps

                    echo "Backend logs:"
                    docker logs backend-api --tail 30

                    echo "Testing backend..."
                    curl -f http://localhost:5000/ || true

                    echo "Testing frontend..."
                    curl -f http://localhost:3000/ || true
                '''
            }
        }
    }

    post {
        always {
            echo 'CI/CD Pipeline finished.'
        }

        success {
            echo 'CI/CD Pipeline completed successfully.'
        }

        failure {
            echo 'CI/CD Pipeline failed. Check the failed stage and Jenkins console output.'
        }
    }
}

