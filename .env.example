# Copy to .env in the project root and fill in real values.
# Never commit the real .env file. docker-compose reads this automatically.

MYSQL_ROOT_PASSWORD=replace_with_a_strong_generated_password
MYSQL_DATABASE=crud_app
MYSQL_USER=crud_app_user
MYSQL_PASSWORD=replace_with_a_different_strong_password

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

CLIENT_URL=http://localhost:3000

# Backend API base URL baked into the React build at build time
REACT_APP_API=http://localhost:5000
